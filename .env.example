# mock = in-memory fixtures (no backend needed)
# api  = real backend
NEXT_PUBLIC_DATA_SOURCE=mock

# Only used when NEXT_PUBLIC_DATA_SOURCE=api
NEXT_PUBLIC_API_URL=https://api.learnifyng.tech

# Simulated network conditions for the mock layer
NEXT_PUBLIC_MOCK_LATENCY_MS=600
NEXT_PUBLIC_MOCK_ERROR_RATE=0

# How long the mock's async third-party checks run for.
# Raise MOCK_IDENTITY_MS to hold a verification pending across a reload.
NEXT_PUBLIC_MOCK_IDENTITY_MS=20000
NEXT_PUBLIC_MOCK_WHATSAPP_MS=15000

# --- Where this deployment lives -----------------------------------
# Absolute origin, no trailing slash. Every shareable link, canonical
# and OG tag is built from it, so a wrong value here is a wrong link
# in somebody's WhatsApp group.
#
# On Vercel this can be left unset: NEXT_PUBLIC_VERCEL_URL is provided
# automatically and is used as the fallback. Unset and not on Vercel,
# it defaults to http://localhost:3000.
# NEXT_PUBLIC_SITE_ORIGIN=https://learnify-demo.vercel.app

# Apex domain that academies get a subdomain of. UNSET BY DEFAULT.
#
# Unset  -> academies live on paths:      <origin>/c/<academy>/<course>
# Set    -> academies live on subdomains: <academy>.<domain>/<course>
#
# Only set this once the domain has a wildcard DNS record AND a
# wildcard TLS certificate. A *.vercel.app deployment has neither,
# which is why subdomains cannot be the default. middleware.ts maps
# the subdomain back onto the /c/ routes.
# NEXT_PUBLIC_TENANT_DOMAIN=learnify.com

# The account the public landing page demonstrates.
# NEXT_PUBLIC_DEMO_CREATOR_ID=creator_001

# --- Which features this build offers -------------------------------
# Unset, each follows the data source: everything on against the mock,
# and only what the backend can answer against the API. Set one to "1"
# to force it on once its endpoints exist, or "0" to force it off.
#
#   NEXT_PUBLIC_FEATURE_AI_BUILDER=1
#   NEXT_PUBLIC_FEATURE_QUIZZES=1
#   NEXT_PUBLIC_FEATURE_SUBMISSIONS=1
#   NEXT_PUBLIC_FEATURE_CERTIFICATES=1
#   NEXT_PUBLIC_FEATURE_PLANS=1
#   NEXT_PUBLIC_FEATURE_PAYMENTS=1
#   NEXT_PUBLIC_FEATURE_WHATSAPP=1
#   NEXT_PUBLIC_FEATURE_MARKETPLACE=1
#
# Password sign-in is the one that works the other way round: on
# against the API, off against the mock. Set it to 0 once one-time
# codes are arriving reliably.
#   NEXT_PUBLIC_FEATURE_PASSWORD_AUTH=0
